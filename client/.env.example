# PostHog Analytics
# Get your key at https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring
# Get your DSN at https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=credit-scoring
SENTRY_AUTH_TOKEN=your_auth_token_here

# ── Mainnet (set to "true" to switch from Testnet → Mainnet) ──
NEXT_PUBLIC_USE_MAINNET=false
NEXT_PUBLIC_MAINNET_CONTRACT_ADDRESS=C...your_mainnet_contract_address
NEXT_PUBLIC_MAINNET_RPC_URL=https://soroban-mainnet.stellar.org

# ── Fee Sponsorship (Gasless Transactions) ────────────────────
# Secret key of the sponsor account that pays fees on behalf of users.
# Must be funded with XLM on mainnet. NEVER expose this in the browser.
SPONSOR_SECRET_KEY=S...your_sponsor_secret_key
